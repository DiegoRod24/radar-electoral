# Radar Meta - Dropbox + Cloudflare Pages Functions
# NO se usa Supabase para guardar evidencia.
#
# Opción rápida para probar (secreto Cloudflare):
DROPBOX_ACCESS_TOKEN=
#
# Opción recomendada para producción (refresh token):
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=
#
# Carpeta raíz dentro de Dropbox:
DROPBOX_ROOT=/RADAR_META_TESIS
#
# IMPORTANTE:
# Estas variables son SECRETOS DEL BACKEND. No deben usar prefijo VITE_
# ni escribirse dentro del JavaScript público.